{
  "name": "railway-gateway",
  "version": "1.0.0",
  "description": "Proxy Gateway Universal Direct dengan Cloudflare Argo Tunnel",
  "main": "server.js",
  "scripts": {
    "postinstall": "wget -O cloudflared https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 && chmod +x cloudflared",
    "start": "node server.js & ./cloudflared tunnel --url http://localhost:${PORT:-8080}"
  },
  "dependencies": {
    "ws": "^8.14.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "author": "Kuncung",
  "license": "MIT"
}
